# 🌐 SERVIDOR
PORT=3000
NODE_ENV=production

# ══════════════════════════════════════════════════════════════
# 📸 INSTAGRAM / META APP — OBRIGATÓRIO PARA LOGIN OAUTH
# Crie seu app em: https://developers.facebook.com/apps/
# Tipo de app: "Consumidor" ou "Empresa"
# Produto necessário: "Login do Instagram"
# ══════════════════════════════════════════════════════════════
IG_APP_ID=seu_app_id_aqui
IG_APP_SECRET=seu_app_secret_aqui

# URL de callback — DEVE ser cadastrada exatamente assim no Meta Developer Portal
# Em: App > Login do Instagram > Configurações OAuth > URIs de redirecionamento válidas
REDIRECT_URI=https://seudominio.com/auth/callback

# 🗄️ BANCO DE DADOS (RENDER)
# Se estiver vazio, o app usará SQLite local automaticamente.
# Exemplo: postgres://user:password@host:port/dbname
DATABASE_URL=

# 🔐 CREDENCIAIS DE ACESSO AO PAINEL
LOGIN_USER=admin
LOGIN_PASS=admin123

# 🖼️ IMGBB API (UPLOAD DE IMAGENS)
# Obtenha em: https://api.imgbb.com/
IMGBB_KEY=

# 🎬 CLOUDINARY (UPLOAD DE VÍDEOS/REELS)
# Obtenha em: https://cloudinary.com/
CLOUDINARY_NAME=
CLOUDINARY_PRESET=
