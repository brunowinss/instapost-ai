# Copie este arquivo para .env.migration e preencha com as suas connection strings.
# O .env.migration é ignorado pelo git — as credenciais não saem da sua máquina.

# Banco de ORIGEM (Neon — de onde os dados vêm)
SOURCE_URL=postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Banco de DESTINO (Supabase — para onde os dados vão)
# Use a "Connection string / URI" em Project Settings -> Database
TARGET_URL=postgresql://postgres:senha@db-xxxx.supabase.co:5432/postgres
